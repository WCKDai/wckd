{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wckd.protocol/schemas/prospect.schema.json",
  "title": "Prospect",
  "description": "Demand, competition, ROI, regulation, timing, risks, kill criteria and tripwires. Output of K4.",
  "type": "object",
  "required": ["id", "brief_id", "demand", "competition", "differentiation", "roi", "regulatory", "timing", "risks", "kill_criteria", "tripwires", "recommendation", "provenance"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "brief_id": { "$ref": "common.schema.json#/$defs/id" },
    "demand": { "type": "object", "required": ["signals", "users_addressable", "users_year1"], "properties": { "signals": { "type": "array", "items": { "type": "string" } }, "users_addressable": { "type": "string" }, "users_year1": { "type": "string" }, "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence" } } } },
    "competition": { "type": "array", "items": { "type": "object", "required": ["candidate_id", "why_someone_uses_ours_instead"], "properties": { "candidate_id": { "$ref": "common.schema.json#/$defs/id" }, "why_someone_uses_ours_instead": { "type": "string" } } } },
    "differentiation": { "type": "string", "description": "'none' is a valid answer and usually means KILL" },
    "roi": { "type": "object", "required": ["investment", "value_year1", "payback_months"], "properties": { "investment": { "$ref": "common.schema.json#/$defs/money" }, "value_year1": { "$ref": "common.schema.json#/$defs/money" }, "payback_months": { "type": "string", "description": "a range matching the cost confidence class" }, "vs_not_doing": { "type": "string" } } },
    "regulatory": { "type": "array", "items": { "type": "object", "required": ["rule", "applies_because", "penalty"], "properties": { "rule": { "type": "string" }, "applies_because": { "type": "string" }, "penalty": { "type": "string" } } } },
    "timing": { "type": "object", "required": ["why_now"], "properties": { "why_now": { "type": "string" }, "why_wait": { "type": "string" } } },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "likelihood", "impact", "owner", "mitigation"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "statement": { "type": "string" },
          "category": { "type": "string", "enum": ["supply", "dependency", "people", "cost", "safety", "security", "regulatory", "market", "technical", "other"] },
          "likelihood": { "type": "integer", "minimum": 1, "maximum": 5 },
          "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
          "owner": { "$ref": "common.schema.json#/$defs/role" },
          "mitigation": { "type": "string" },
          "graves_cited": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } }
        },
        "additionalProperties": false
      }
    },
    "kill_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tripwires": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["signal", "by", "then"], "properties": { "signal": { "type": "string" }, "by": { "$ref": "common.schema.json#/$defs/date" }, "then": { "type": "string", "enum": ["RE_JUDGE", "RE_CANVASS", "RE_WANT", "KILL"] } } } },
    "recommendation": { "type": "object", "required": ["decision", "confidence", "rationale"], "properties": { "decision": { "type": "string", "enum": ["PROCEED", "WAIT", "KILL"] }, "confidence": { "$ref": "common.schema.json#/$defs/confidence" }, "rationale": { "type": "string" } } },
    "signoffs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/signoff" } },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "additionalProperties": false
}
