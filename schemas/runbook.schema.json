{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wckd.protocol/schemas/runbook.schema.json",
  "title": "Runbook",
  "description": "Operation: owner, SLOs, alerts, on-call, maintenance, spares, patching, opex, drift, re-entry, end of life. Output of D5; kept true for the life of the thing.",
  "type": "object",
  "required": ["id", "release_id", "owner", "slos", "alerts", "oncall", "maintenance_cadence", "patching_policy", "opex_budget_monthly", "opex_actual", "drift_checks", "reentry_triggers", "end_of_life", "provenance"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "release_id": { "$ref": "common.schema.json#/$defs/id" },
    "owner": { "type": "object", "required": ["name", "kind"], "properties": { "name": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["person", "rota"] }, "contact": { "type": "string" } } },
    "slos": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "bar_dimension", "target", "measure", "alert"], "properties": { "name": { "type": "string" }, "bar_dimension": { "$ref": "common.schema.json#/$defs/bar_dimension" }, "target": { "type": "string" }, "measure": { "type": "string" }, "alert": { "type": "string", "description": "alert id" } } } },
    "alerts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "condition", "route", "owner"], "properties": { "id": { "type": "string" }, "condition": { "type": "string" }, "route": { "type": "string" }, "owner": { "type": "string" }, "tested_at": { "$ref": "common.schema.json#/$defs/timestamp" } } } },
    "oncall": { "type": "object", "required": ["rota", "escalation"], "properties": { "rota": { "type": "string" }, "escalation": { "type": "array", "items": { "type": "string" } } } },
    "maintenance_cadence": { "type": "array", "items": { "type": "object", "required": ["task", "every", "owner"], "properties": { "task": { "type": "string" }, "every": { "type": "string" }, "owner": { "type": "string" }, "last_done": { "$ref": "common.schema.json#/$defs/date" } } } },
    "spares_and_consumables": { "type": "array", "items": { "type": "object", "required": ["item", "reorder_at", "lead_time"], "properties": { "item": { "type": "string" }, "on_hand": { "type": "integer" }, "reorder_at": { "type": "integer" }, "lead_time": { "type": "string" }, "supplier": { "type": "string" } } } },
    "patching_policy": { "type": "string" },
    "kept_dependencies_watched": { "type": "array", "items": { "type": "object", "required": ["candidate_id", "version", "watch"], "properties": { "candidate_id": { "$ref": "common.schema.json#/$defs/id" }, "version": { "type": "string" }, "watch": { "type": "string" } } } },
    "opex_budget_monthly": { "$ref": "common.schema.json#/$defs/money" },
    "opex_actual": { "type": "array", "items": { "type": "object", "required": ["month", "amount", "evidence"], "properties": { "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" }, "amount": { "type": "number" }, "over_budget_pct": { "type": "number" }, "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence" } } } } },
    "drift_checks": { "type": "array", "items": { "type": "object", "required": ["at", "bar_still_met", "dependencies_changed", "new_candidates_found", "action"], "properties": { "at": { "$ref": "common.schema.json#/$defs/timestamp" }, "bar_still_met": { "type": "boolean" }, "dependencies_changed": { "type": "array", "items": { "type": "string" } }, "new_candidates_found": { "type": "array", "items": { "type": "string" } }, "action": { "type": "string", "enum": ["none", "RE_WANT", "RE_CANVASS", "RE_JUDGE", "KILL"] }, "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence" } } } } },
    "reentry_triggers": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["condition", "action"], "properties": { "condition": { "type": "string" }, "action": { "type": "string", "enum": ["RE_WANT", "RE_CANVASS", "RE_JUDGE", "KILL"] } } } },
    "end_of_life": { "type": "object", "required": ["when", "how", "tell_users"], "properties": { "when": { "type": "string" }, "how": { "type": "string", "description": "from cost.exit" }, "tell_users": { "type": "string" } } },
    "signoffs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/signoff" } },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "additionalProperties": false
}
