{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wckd.protocol/schemas/validation.schema.json",
  "title": "Proof",
  "description": "Independent validation record for one work order. Output of D2.",
  "type": "object",
  "required": ["id", "workorder_id", "validator", "builder", "independence_attestation", "environment", "tests", "reproduced_from_clean", "result", "defects", "evidence", "provenance"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "workorder_id": { "$ref": "common.schema.json#/$defs/id" },
    "validator": { "type": "string" },
    "builder": { "type": "string" },
    "independence_attestation": { "type": "object", "required": ["independent", "note"], "properties": { "independent": { "type": "boolean" }, "note": { "type": "string" } } },
    "environment": { "type": "object", "required": ["description", "clean"], "properties": { "description": { "type": "string" }, "clean": { "type": "boolean" }, "fresh_unit_serial": { "type": "string" } } },
    "tests_written_before_reading_implementation": { "type": "boolean" },
    "tests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "bar_dimension", "method", "expected", "observed", "pass"],
        "properties": {
          "name": { "type": "string" },
          "bar_dimension": { "$ref": "common.schema.json#/$defs/bar_dimension" },
          "acceptance_ref": { "type": "string" },
          "method": { "type": "string" },
          "expected": { "type": "string" },
          "observed": { "type": "string" },
          "pass": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "measurements": { "type": "array", "items": { "type": "object", "required": ["name", "value", "unit"], "properties": { "name": { "type": "string" }, "value": { "type": "number" }, "unit": { "type": "string" }, "conditions": { "type": "string" } } } },
    "reproduced_from_clean": { "type": "boolean" },
    "undocumented_steps": { "type": "array", "items": { "type": "string" } },
    "result": { "type": "string", "enum": ["PROVEN", "PARTIAL", "FAILED"] },
    "defects": { "type": "array", "items": { "type": "object", "required": ["title", "severity", "repro"], "properties": { "title": { "type": "string" }, "severity": { "$ref": "common.schema.json#/$defs/severity" }, "repro": { "type": "string" } } } },
    "retest_of": { "$ref": "common.schema.json#/$defs/id" },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } },
    "signoffs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/signoff" } },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "additionalProperties": false
}
