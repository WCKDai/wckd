{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wckd.protocol/schemas/release.schema.json",
  "title": "Release",
  "description": "Rollout strategy, steps, go/no-go, rollback drill, manufacturing handoff. Output of D4.",
  "type": "object",
  "required": ["id", "plan_id", "strategy", "environments", "steps", "go_no_go", "rollback", "monitoring_live_before_cutover", "findings_all_dispositioned", "outcome", "provenance"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "plan_id": { "$ref": "common.schema.json#/$defs/id" },
    "strategy": { "type": "string", "enum": ["canary", "staged", "blue_green", "pilot_batch", "big_bang"] },
    "big_bang_justification": { "type": "string" },
    "environments": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["order", "action", "criteria_to_proceed", "signs"], "properties": { "order": { "type": "integer" }, "action": { "type": "string" }, "criteria_to_proceed": { "type": "array", "items": { "type": "string" } }, "signs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/role" } }, "done_at": { "$ref": "common.schema.json#/$defs/timestamp" } } } },
    "go_no_go": { "type": "object", "required": ["criteria", "signoffs"], "properties": { "criteria": { "type": "array", "items": { "type": "string" } }, "signoffs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/signoff" } } } },
    "rollback": { "type": "object", "required": ["method", "drill_at", "drill_result", "drill_time", "max_acceptable_time"], "properties": { "method": { "type": "string" }, "drill_at": { "$ref": "common.schema.json#/$defs/timestamp" }, "drill_result": { "type": "string", "enum": ["pass", "fail"] }, "drill_time": { "type": "string" }, "max_acceptable_time": { "type": "string" }, "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence" } } } },
    "hardware": { "type": "object", "required": ["pilot_batch_size", "manufacturing_handoff", "qc_sampling_plan", "serial_tracking", "logistics", "repair_recall_path"], "properties": { "pilot_batch_size": { "type": "integer" }, "manufacturing_handoff": { "type": "string" }, "supplier_confirmations": { "type": "array", "items": { "type": "string" } }, "qc_sampling_plan": { "type": "string" }, "serial_tracking": { "type": "string" }, "logistics": { "type": "string" }, "repair_recall_path": { "type": "object", "required": ["description", "rehearsed_at", "rehearsal_result"], "properties": { "description": { "type": "string" }, "rehearsed_at": { "$ref": "common.schema.json#/$defs/timestamp" }, "rehearsal_result": { "type": "string", "enum": ["pass", "fail"] } } } } },
    "monitoring_live_before_cutover": { "type": "boolean" },
    "findings_all_dispositioned": { "type": "boolean" },
    "cost_reestimate_at_gate": { "type": "string" },
    "outcome": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["planned", "in_progress", "shipped", "rolled_back", "held"] }, "incidents": { "type": "array", "items": { "type": "string" } }, "timeline": { "type": "array", "items": { "type": "string" } } } },
    "signoffs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/signoff" } },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "allOf": [ { "if": { "properties": { "strategy": { "const": "big_bang" } } }, "then": { "required": ["big_bang_justification"] } } ],
  "additionalProperties": false
}
