{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wckd.protocol/schemas/verdict.schema.json",
  "title": "Verdict",
  "description": "Per-capability KEEP / BEND / BUILD / WAIT / KILL and the overall decision. Output of K1.",
  "type": "object",
  "required": ["id", "brief_id", "landscape_id", "decisions", "overall", "overall_rationale", "reuse_ratio", "signoffs", "provenance"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "brief_id": { "$ref": "common.schema.json#/$defs/id" },
    "landscape_id": { "$ref": "common.schema.json#/$defs/id" },
    "decisions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability_id", "verdict", "rationale", "evidence", "confidence"],
        "properties": {
          "capability_id": { "$ref": "common.schema.json#/$defs/id" },
          "verdict": { "type": "string", "enum": ["KEEP", "BEND", "BUILD", "WAIT", "KILL"] },
          "chosen_candidate": { "$ref": "common.schema.json#/$defs/id" },
          "delta": { "type": "string", "description": "BEND: exactly what is adapted, extended or forked" },
          "rationale": { "type": "string" },
          "why_not_keep": { "type": "string" },
          "why_not_bend": { "type": "string" },
          "cited_candidates": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
          "tripwire": { "type": "object", "required": ["condition", "by"], "properties": { "condition": { "type": "string" }, "by": { "$ref": "common.schema.json#/$defs/date" } } },
          "keep_cost_note": { "type": "string" },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } },
          "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
        },
        "allOf": [
          { "if": { "properties": { "verdict": { "const": "BUILD" } } }, "then": { "required": ["why_not_keep", "why_not_bend", "cited_candidates"] } },
          { "if": { "properties": { "verdict": { "const": "WAIT" } } }, "then": { "required": ["tripwire"] } },
          { "if": { "properties": { "verdict": { "enum": ["KEEP", "BEND"] } } }, "then": { "required": ["chosen_candidate"] } },
          { "if": { "properties": { "verdict": { "const": "BEND" } } }, "then": { "required": ["delta"] } }
        ],
        "additionalProperties": false
      }
    },
    "overall": { "type": "string", "enum": ["PROCEED", "WAIT", "KILL"] },
    "overall_rationale": { "type": "string" },
    "reuse_ratio": { "$ref": "common.schema.json#/$defs/confidence" },
    "tripwires": { "type": "array", "items": { "type": "object", "required": ["condition", "by"], "properties": { "condition": { "type": "string" }, "by": { "$ref": "common.schema.json#/$defs/date" } } } },
    "bar_changes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/bar_change" } },
    "appeals": { "type": "array", "items": { "type": "object", "required": ["by", "capability_id", "new_evidence", "outcome"], "properties": { "by": { "$ref": "common.schema.json#/$defs/role" }, "capability_id": { "$ref": "common.schema.json#/$defs/id" }, "new_evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence" } }, "outcome": { "type": "string" } } } },
    "signoffs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/signoff" } },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "additionalProperties": false
}
