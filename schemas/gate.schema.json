{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wckd.protocol/schemas/gate.schema.json",
  "title": "Gate record",
  "description": "The decision at a gate, with checked artifacts, criteria, evidence and sign-offs.",
  "type": "object",
  "required": ["gate_id", "project", "at", "artifacts_checked", "criteria", "decision", "signoffs"],
  "properties": {
    "gate_id": { "type": "string", "enum": ["G-W", "G-C", "G-K", "G-D1", "G-D2", "G-D3", "G-D4", "G-D5"] },
    "project": { "type": "string" },
    "at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "reentry": { "type": "boolean", "default": false },
    "artifacts_checked": { "type": "array", "items": { "type": "object", "required": ["path", "valid"], "properties": { "path": { "type": "string" }, "valid": { "type": "boolean" }, "hash": { "type": "string" }, "error": { "type": "string" } } } },
    "criteria": { "type": "array", "items": { "type": "object", "required": ["statement", "met"], "properties": { "statement": { "type": "string" }, "met": { "type": "boolean" }, "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence" } }, "note": { "type": "string" } } } },
    "decision": { "type": "string", "enum": ["PASS", "FAIL", "PASS_WITH_CONDITIONS"] },
    "conditions": { "type": "array", "items": { "type": "object", "required": ["statement", "owner", "due_gate"], "properties": { "statement": { "type": "string" }, "owner": { "$ref": "common.schema.json#/$defs/role" }, "due_gate": { "type": "string" }, "closed_at": { "$ref": "common.schema.json#/$defs/timestamp" } } } },
    "cost_reestimate": { "type": "object", "properties": { "build": { "$ref": "common.schema.json#/$defs/money" }, "run_monthly": { "$ref": "common.schema.json#/$defs/money" }, "variance_within_class": { "type": "boolean" } } },
    "signoffs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/signoff" } },
    "human_signoff": { "$ref": "common.schema.json#/$defs/signoff" },
    "notes": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "gate_id": { "enum": ["G-W", "G-K", "G-D4"] } } }, "then": { "required": ["human_signoff"] } },
    { "if": { "properties": { "decision": { "const": "PASS_WITH_CONDITIONS" } } }, "then": { "required": ["conditions"] } }
  ],
  "additionalProperties": false
}
