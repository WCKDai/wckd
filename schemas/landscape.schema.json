{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wckd.protocol/schemas/landscape.schema.json",
  "title": "Landscape",
  "description": "What exists: searches, candidates, trials, scores, graveyard, coverage, proven absences. Output of phase C.",
  "type": "object",
  "required": ["id", "brief_id", "lessons_read", "search_log", "candidates", "graveyard", "coverage", "absence_declarations", "summary", "provenance"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "brief_id": { "$ref": "common.schema.json#/$defs/id" },
    "time_box": { "type": "string" },
    "lessons_read": { "type": "array", "items": { "type": "string" } },
    "not_checked": { "type": "array", "items": { "type": "string" } },
    "search_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "source_class", "query", "tool", "at", "results_count"],
        "properties": {
          "capability_id": { "$ref": "common.schema.json#/$defs/id" },
          "source_class": { "$ref": "common.schema.json#/$defs/source_class" },
          "query": { "type": "string" },
          "tool": { "type": "string" },
          "at": { "$ref": "common.schema.json#/$defs/timestamp" },
          "results_count": { "type": "integer", "minimum": 0 },
          "kept": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "description": "candidate ids kept from this query" }
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "locator", "checked_at", "tried", "evidence"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "kind": { "$ref": "common.schema.json#/$defs/source_class" },
          "locator": { "type": "string" },
          "version": { "type": "string" },
          "maturity": { "type": "string", "enum": ["experimental", "beta", "stable", "mature", "legacy", "discontinued"] },
          "license": { "type": "string" },
          "cost": { "type": "object", "properties": { "keep": { "$ref": "common.schema.json#/$defs/money" }, "run_monthly": { "$ref": "common.schema.json#/$defs/money" }, "unit": { "$ref": "common.schema.json#/$defs/money" }, "moq": { "type": "integer" }, "lead_time": { "type": "string" }, "exit": { "$ref": "common.schema.json#/$defs/money" } } },
          "checked_at": { "$ref": "common.schema.json#/$defs/timestamp" },
          "tried": { "type": "boolean" },
          "trial_notes": { "type": "string" },
          "works": { "type": "array", "items": { "type": "string" } },
          "doesnt": { "type": "array", "items": { "type": "string" } },
          "fit": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["capability_id", "score", "meets_bar"],
              "properties": {
                "capability_id": { "$ref": "common.schema.json#/$defs/id" },
                "score": { "$ref": "common.schema.json#/$defs/confidence" },
                "meets_bar": { "type": "boolean" },
                "per_dimension": { "type": "array", "items": { "type": "object", "required": ["name", "meets"], "properties": { "name": { "$ref": "common.schema.json#/$defs/bar_dimension" }, "meets": { "type": "boolean" }, "note": { "type": "string" }, "grade": { "type": "string", "enum": ["measured", "tried", "found", "reasoned"] } } } },
                "notes": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "conflicts": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } }
        },
        "additionalProperties": false
      }
    },
    "graveyard": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "what_it_tried", "why_it_died", "lesson", "evidence"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "what_it_tried": { "type": "string" },
          "why_it_died": { "type": "string" },
          "lesson": { "type": "string" },
          "capability_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } }
        },
        "additionalProperties": false
      }
    },
    "graveyard_note": { "type": "string", "description": "Only for a space with genuinely no history: say so in one sentence, with the search log that supports it. An empty graveyard plus an empty note fails G-C." },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "source_classes_searched", "candidates_evaluated"],
        "properties": {
          "capability_id": { "$ref": "common.schema.json#/$defs/id" },
          "source_classes_searched": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/source_class" } },
          "candidates_evaluated": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
          "best_fit": { "type": "object", "properties": { "candidate_id": { "$ref": "common.schema.json#/$defs/id" }, "score": { "$ref": "common.schema.json#/$defs/confidence" } } },
          "gap": { "type": "string", "description": "which dimension, by how much; or empty when best fit meets the Bar" },
          "graves": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
          "stale": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "absence_declarations": {
      "type": "array",
      "items": { "type": "object", "required": ["capability_id", "search_log_refs", "statement"], "properties": { "capability_id": { "$ref": "common.schema.json#/$defs/id" }, "search_log_refs": { "type": "array", "minItems": 5, "items": { "type": "integer" }, "description": "indices into search_log" }, "statement": { "type": "string" } } }
    },
    "summary": { "type": "string", "description": "one minute for the Judge" },
    "signoffs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/signoff" } },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "additionalProperties": false
}
