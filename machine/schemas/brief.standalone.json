{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brief",
  "description": "The want, structured, with the Bar. Output of phase W.",
  "type": "object",
  "required": [
    "id",
    "wish",
    "restated",
    "realm",
    "capabilities",
    "constraints",
    "non_goals",
    "horizon",
    "budget_ceiling",
    "bar",
    "done_condition",
    "lessons_read",
    "questions_asked",
    "provenance"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/common_id"
    },
    "wish": {
      "type": "string",
      "description": "verbatim"
    },
    "restated": {
      "type": "string"
    },
    "realm": {
      "$ref": "#/$defs/common_realm"
    },
    "freshness_days": {
      "type": "integer",
      "minimum": 1,
      "default": 90
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "priority",
          "measurable"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/common_id"
          },
          "statement": {
            "type": "string",
            "description": "a <user> can <observe/do> <what> <under what condition>; no solutions named"
          },
          "priority": {
            "$ref": "#/$defs/common_priority"
          },
          "measurable": {
            "type": "boolean"
          },
          "measure": {
            "type": "string"
          },
          "confidence": {
            "$ref": "#/$defs/common_confidence"
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "statement"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "time",
              "place",
              "people",
              "law",
              "existing_system",
              "stated_preference",
              "other"
            ]
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "horizon": {
      "type": "object",
      "required": [
        "first_value",
        "lifetime"
      ],
      "properties": {
        "first_value": {
          "type": "string"
        },
        "lifetime": {
          "type": "string"
        }
      }
    },
    "budget_ceiling": {
      "type": "object",
      "required": [
        "build",
        "run_monthly"
      ],
      "properties": {
        "build": {
          "$ref": "#/$defs/common_money"
        },
        "run_monthly": {
          "$ref": "#/$defs/common_money"
        },
        "unit": {
          "$ref": "#/$defs/common_money"
        }
      }
    },
    "bar": {
      "type": "object",
      "required": [
        "in_scope",
        "dimensions",
        "set_by"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/common_bar_dimension"
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "threshold",
              "measure",
              "why"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/common_bar_dimension"
              },
              "threshold": {
                "type": "string"
              },
              "measure": {
                "type": "string",
                "description": "the instrument, test or source that decides"
              },
              "why": {
                "type": "string"
              },
              "standard": {
                "type": "string",
                "description": "named standard and version, if any"
              }
            },
            "additionalProperties": false
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "thresholds unrealistic at the budget ceiling, with evidence"
        },
        "lessons_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "set_by": {
          "$ref": "#/$defs/common_signoff"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common_bar_change"
          }
        }
      },
      "additionalProperties": false
    },
    "done_condition": {
      "type": "object",
      "required": [
        "statement",
        "test"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "test": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lessons_read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions_asked": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "asked_at": {
            "$ref": "#/$defs/common_timestamp"
          }
        }
      }
    },
    "signoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/common_signoff"
      }
    },
    "provenance": {
      "$ref": "#/$defs/common_provenance"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "common_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "common_realm": {
      "type": "string",
      "enum": [
        "digital",
        "physical",
        "hybrid"
      ]
    },
    "common_priority": {
      "type": "string",
      "enum": [
        "must",
        "should",
        "could"
      ]
    },
    "common_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "common_money": {
      "type": "object",
      "required": [
        "amount",
        "currency",
        "confidence_class"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "confidence_class": {
          "$ref": "#/$defs/common_confidence_class"
        },
        "basis": {
          "type": "string",
          "description": "how the number was derived"
        },
        "source": {
          "type": "string"
        },
        "priced_at": {
          "$ref": "#/$defs/common_date"
        }
      },
      "additionalProperties": false
    },
    "common_confidence_class": {
      "type": "string",
      "enum": [
        "rom",
        "budgetary",
        "definitive"
      ],
      "description": "rom +-50%, budgetary +-25%, definitive +-10%"
    },
    "common_date": {
      "type": "string",
      "format": "date"
    },
    "common_bar_dimension": {
      "type": "string",
      "enum": [
        "correctness",
        "performance",
        "reliability",
        "security",
        "safety",
        "cost_build",
        "cost_run",
        "cost_unit",
        "usability",
        "maintainability",
        "compliance",
        "sustainability",
        "exit"
      ]
    },
    "common_signoff": {
      "type": "object",
      "required": [
        "by",
        "role",
        "at",
        "decision"
      ],
      "properties": {
        "by": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/common_role"
        },
        "at": {
          "$ref": "#/$defs/common_timestamp"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "reject",
            "approve_with_conditions"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "common_role": {
      "type": "string",
      "enum": [
        "conductor",
        "scribe",
        "listener",
        "barkeeper",
        "scout",
        "appraiser",
        "cartographer",
        "judge",
        "architect",
        "quartermaster",
        "prospector",
        "planner",
        "builder",
        "validator",
        "breaker",
        "shipper",
        "keeper",
        "human"
      ]
    },
    "common_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "common_bar_change": {
      "type": "object",
      "required": [
        "dimension",
        "old",
        "new",
        "why",
        "requested_by",
        "signoffs"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/common_bar_dimension"
        },
        "old": {},
        "new": {},
        "why": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common_evidence"
          }
        },
        "requested_by": {
          "$ref": "#/$defs/common_role"
        },
        "signoffs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/common_signoff"
          },
          "description": "barkeeper and human"
        }
      },
      "additionalProperties": false
    },
    "common_evidence": {
      "type": "object",
      "required": [
        "kind",
        "locator",
        "summary",
        "captured_at",
        "captured_by",
        "confidence"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/common_evidence_kind"
        },
        "locator": {
          "type": "string",
          "description": "URL, path, serial, log id - whatever lets a stranger find it"
        },
        "summary": {
          "type": "string"
        },
        "captured_at": {
          "$ref": "#/$defs/common_timestamp"
        },
        "captured_by": {
          "$ref": "#/$defs/common_role"
        },
        "confidence": {
          "$ref": "#/$defs/common_confidence"
        },
        "grade": {
          "type": "string",
          "enum": [
            "measured",
            "tried",
            "found",
            "reasoned"
          ]
        }
      },
      "additionalProperties": false
    },
    "common_evidence_kind": {
      "type": "string",
      "enum": [
        "url",
        "file",
        "log",
        "measurement",
        "repro",
        "sample",
        "interview",
        "memory",
        "receipt",
        "photo"
      ]
    },
    "common_provenance": {
      "type": "object",
      "required": [
        "produced_by",
        "produced_at"
      ],
      "properties": {
        "produced_by": {
          "$ref": "#/$defs/common_role"
        },
        "produced_at": {
          "$ref": "#/$defs/common_timestamp"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common_ref"
          }
        },
        "runtime": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "common_ref": {
      "type": "object",
      "required": [
        "artifact",
        "path"
      ],
      "properties": {
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "description": "sha256 of the file at hand-off"
        },
        "fragment": {
          "type": "string",
          "description": "optional JSON pointer or field"
        }
      },
      "additionalProperties": false
    }
  }
}
