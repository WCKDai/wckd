{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work order",
  "description": "The unit of build, proof and break.",
  "type": "object",
  "required": [
    "id",
    "plan_id",
    "component_id",
    "realm",
    "spec",
    "acceptance",
    "deliverables",
    "assigned_to",
    "status",
    "build_log",
    "provenance"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/common_id"
    },
    "plan_id": {
      "$ref": "#/$defs/common_id"
    },
    "component_id": {
      "$ref": "#/$defs/common_id"
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/common_id"
      }
    },
    "realm": {
      "$ref": "#/$defs/common_realm"
    },
    "spec": {
      "type": "string"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "bar_dimension"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "bar_dimension": {
            "$ref": "#/$defs/common_bar_dimension"
          },
          "measure": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/common_id"
      }
    },
    "graves_to_read": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/common_id"
      }
    },
    "assigned_to": {
      "type": "object",
      "required": [
        "builder",
        "validator",
        "breaker"
      ],
      "properties": {
        "builder": {
          "type": "string"
        },
        "validator": {
          "type": "string"
        },
        "breaker": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "building",
        "built",
        "proving",
        "proven",
        "breaking",
        "hardened",
        "blocked",
        "cancelled"
      ]
    },
    "blocked_by": {
      "type": "string"
    },
    "build_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "by",
          "did",
          "saw"
        ],
        "properties": {
          "at": {
            "$ref": "#/$defs/common_timestamp"
          },
          "by": {
            "type": "string"
          },
          "did": {
            "type": "string"
          },
          "ran": {
            "type": "string"
          },
          "saw": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/common_evidence"
            }
          }
        }
      }
    },
    "as_built_deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "physical": {
      "type": "object",
      "properties": {
        "drawings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bom_rev": {
          "type": "string"
        },
        "firmware_version": {
          "type": "string"
        },
        "serials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/common_provenance"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "common_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "common_realm": {
      "type": "string",
      "enum": [
        "digital",
        "physical",
        "hybrid"
      ]
    },
    "common_bar_dimension": {
      "type": "string",
      "enum": [
        "correctness",
        "performance",
        "reliability",
        "security",
        "safety",
        "cost_build",
        "cost_run",
        "cost_unit",
        "usability",
        "maintainability",
        "compliance",
        "sustainability",
        "exit"
      ]
    },
    "common_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "common_evidence": {
      "type": "object",
      "required": [
        "kind",
        "locator",
        "summary",
        "captured_at",
        "captured_by",
        "confidence"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/common_evidence_kind"
        },
        "locator": {
          "type": "string",
          "description": "URL, path, serial, log id - whatever lets a stranger find it"
        },
        "summary": {
          "type": "string"
        },
        "captured_at": {
          "$ref": "#/$defs/common_timestamp"
        },
        "captured_by": {
          "$ref": "#/$defs/common_role"
        },
        "confidence": {
          "$ref": "#/$defs/common_confidence"
        },
        "grade": {
          "type": "string",
          "enum": [
            "measured",
            "tried",
            "found",
            "reasoned"
          ]
        }
      },
      "additionalProperties": false
    },
    "common_evidence_kind": {
      "type": "string",
      "enum": [
        "url",
        "file",
        "log",
        "measurement",
        "repro",
        "sample",
        "interview",
        "memory",
        "receipt",
        "photo"
      ]
    },
    "common_role": {
      "type": "string",
      "enum": [
        "conductor",
        "scribe",
        "listener",
        "barkeeper",
        "scout",
        "appraiser",
        "cartographer",
        "judge",
        "architect",
        "quartermaster",
        "prospector",
        "planner",
        "builder",
        "validator",
        "breaker",
        "shipper",
        "keeper",
        "human"
      ]
    },
    "common_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "common_provenance": {
      "type": "object",
      "required": [
        "produced_by",
        "produced_at"
      ],
      "properties": {
        "produced_by": {
          "$ref": "#/$defs/common_role"
        },
        "produced_at": {
          "$ref": "#/$defs/common_timestamp"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common_ref"
          }
        },
        "runtime": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "common_ref": {
      "type": "object",
      "required": [
        "artifact",
        "path"
      ],
      "properties": {
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "description": "sha256 of the file at hand-off"
        },
        "fragment": {
          "type": "string",
          "description": "optional JSON pointer or field"
        }
      },
      "additionalProperties": false
    }
  }
}
