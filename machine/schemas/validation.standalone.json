{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof",
  "description": "Independent validation record for one work order. Output of D2.",
  "type": "object",
  "required": [
    "id",
    "workorder_id",
    "validator",
    "builder",
    "independence_attestation",
    "environment",
    "tests",
    "reproduced_from_clean",
    "result",
    "defects",
    "evidence",
    "provenance"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/common_id"
    },
    "workorder_id": {
      "$ref": "#/$defs/common_id"
    },
    "validator": {
      "type": "string"
    },
    "builder": {
      "type": "string"
    },
    "independence_attestation": {
      "type": "object",
      "required": [
        "independent",
        "note"
      ],
      "properties": {
        "independent": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "description",
        "clean"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "clean": {
          "type": "boolean"
        },
        "fresh_unit_serial": {
          "type": "string"
        }
      }
    },
    "tests_written_before_reading_implementation": {
      "type": "boolean"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "bar_dimension",
          "method",
          "expected",
          "observed",
          "pass"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "bar_dimension": {
            "$ref": "#/$defs/common_bar_dimension"
          },
          "acceptance_ref": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "pass": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "conditions": {
            "type": "string"
          }
        }
      }
    },
    "reproduced_from_clean": {
      "type": "boolean"
    },
    "undocumented_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "PROVEN",
        "PARTIAL",
        "FAILED"
      ]
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "severity",
          "repro"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/$defs/common_severity"
          },
          "repro": {
            "type": "string"
          }
        }
      }
    },
    "retest_of": {
      "$ref": "#/$defs/common_id"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/common_evidence"
      }
    },
    "signoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/common_signoff"
      }
    },
    "provenance": {
      "$ref": "#/$defs/common_provenance"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "common_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "common_bar_dimension": {
      "type": "string",
      "enum": [
        "correctness",
        "performance",
        "reliability",
        "security",
        "safety",
        "cost_build",
        "cost_run",
        "cost_unit",
        "usability",
        "maintainability",
        "compliance",
        "sustainability",
        "exit"
      ]
    },
    "common_severity": {
      "type": "string",
      "enum": [
        "crit",
        "high",
        "med",
        "low",
        "info"
      ]
    },
    "common_evidence": {
      "type": "object",
      "required": [
        "kind",
        "locator",
        "summary",
        "captured_at",
        "captured_by",
        "confidence"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/common_evidence_kind"
        },
        "locator": {
          "type": "string",
          "description": "URL, path, serial, log id - whatever lets a stranger find it"
        },
        "summary": {
          "type": "string"
        },
        "captured_at": {
          "$ref": "#/$defs/common_timestamp"
        },
        "captured_by": {
          "$ref": "#/$defs/common_role"
        },
        "confidence": {
          "$ref": "#/$defs/common_confidence"
        },
        "grade": {
          "type": "string",
          "enum": [
            "measured",
            "tried",
            "found",
            "reasoned"
          ]
        }
      },
      "additionalProperties": false
    },
    "common_evidence_kind": {
      "type": "string",
      "enum": [
        "url",
        "file",
        "log",
        "measurement",
        "repro",
        "sample",
        "interview",
        "memory",
        "receipt",
        "photo"
      ]
    },
    "common_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "common_role": {
      "type": "string",
      "enum": [
        "conductor",
        "scribe",
        "listener",
        "barkeeper",
        "scout",
        "appraiser",
        "cartographer",
        "judge",
        "architect",
        "quartermaster",
        "prospector",
        "planner",
        "builder",
        "validator",
        "breaker",
        "shipper",
        "keeper",
        "human"
      ]
    },
    "common_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "common_signoff": {
      "type": "object",
      "required": [
        "by",
        "role",
        "at",
        "decision"
      ],
      "properties": {
        "by": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/common_role"
        },
        "at": {
          "$ref": "#/$defs/common_timestamp"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "reject",
            "approve_with_conditions"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "common_provenance": {
      "type": "object",
      "required": [
        "produced_by",
        "produced_at"
      ],
      "properties": {
        "produced_by": {
          "$ref": "#/$defs/common_role"
        },
        "produced_at": {
          "$ref": "#/$defs/common_timestamp"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common_ref"
          }
        },
        "runtime": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "common_ref": {
      "type": "object",
      "required": [
        "artifact",
        "path"
      ],
      "properties": {
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "description": "sha256 of the file at hand-off"
        },
        "fragment": {
          "type": "string",
          "description": "optional JSON pointer or field"
        }
      },
      "additionalProperties": false
    }
  }
}
