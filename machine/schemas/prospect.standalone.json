{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prospect",
  "description": "Demand, competition, ROI, regulation, timing, risks, kill criteria and tripwires. Output of K4.",
  "type": "object",
  "required": [
    "id",
    "brief_id",
    "demand",
    "competition",
    "differentiation",
    "roi",
    "regulatory",
    "timing",
    "risks",
    "kill_criteria",
    "tripwires",
    "recommendation",
    "provenance"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/common_id"
    },
    "brief_id": {
      "$ref": "#/$defs/common_id"
    },
    "demand": {
      "type": "object",
      "required": [
        "signals",
        "users_addressable",
        "users_year1"
      ],
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "users_addressable": {
          "type": "string"
        },
        "users_year1": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common_evidence"
          }
        }
      }
    },
    "competition": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "why_someone_uses_ours_instead"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "#/$defs/common_id"
          },
          "why_someone_uses_ours_instead": {
            "type": "string"
          }
        }
      }
    },
    "differentiation": {
      "type": "string",
      "description": "'none' is a valid answer and usually means KILL"
    },
    "roi": {
      "type": "object",
      "required": [
        "investment",
        "value_year1",
        "payback_months"
      ],
      "properties": {
        "investment": {
          "$ref": "#/$defs/common_money"
        },
        "value_year1": {
          "$ref": "#/$defs/common_money"
        },
        "payback_months": {
          "type": "string",
          "description": "a range matching the cost confidence class"
        },
        "vs_not_doing": {
          "type": "string"
        }
      }
    },
    "regulatory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "applies_because",
          "penalty"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "applies_because": {
            "type": "string"
          },
          "penalty": {
            "type": "string"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "required": [
        "why_now"
      ],
      "properties": {
        "why_now": {
          "type": "string"
        },
        "why_wait": {
          "type": "string"
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "likelihood",
          "impact",
          "owner",
          "mitigation"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/common_id"
          },
          "statement": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "supply",
              "dependency",
              "people",
              "cost",
              "safety",
              "security",
              "regulatory",
              "market",
              "technical",
              "other"
            ]
          },
          "likelihood": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "owner": {
            "$ref": "#/$defs/common_role"
          },
          "mitigation": {
            "type": "string"
          },
          "graves_cited": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/common_id"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "kill_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tripwires": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "signal",
          "by",
          "then"
        ],
        "properties": {
          "signal": {
            "type": "string"
          },
          "by": {
            "$ref": "#/$defs/common_date"
          },
          "then": {
            "type": "string",
            "enum": [
              "RE_JUDGE",
              "RE_CANVASS",
              "RE_WANT",
              "KILL"
            ]
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": [
        "decision",
        "confidence",
        "rationale"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "PROCEED",
            "WAIT",
            "KILL"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/common_confidence"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "signoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/common_signoff"
      }
    },
    "provenance": {
      "$ref": "#/$defs/common_provenance"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "common_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "common_evidence": {
      "type": "object",
      "required": [
        "kind",
        "locator",
        "summary",
        "captured_at",
        "captured_by",
        "confidence"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/common_evidence_kind"
        },
        "locator": {
          "type": "string",
          "description": "URL, path, serial, log id - whatever lets a stranger find it"
        },
        "summary": {
          "type": "string"
        },
        "captured_at": {
          "$ref": "#/$defs/common_timestamp"
        },
        "captured_by": {
          "$ref": "#/$defs/common_role"
        },
        "confidence": {
          "$ref": "#/$defs/common_confidence"
        },
        "grade": {
          "type": "string",
          "enum": [
            "measured",
            "tried",
            "found",
            "reasoned"
          ]
        }
      },
      "additionalProperties": false
    },
    "common_evidence_kind": {
      "type": "string",
      "enum": [
        "url",
        "file",
        "log",
        "measurement",
        "repro",
        "sample",
        "interview",
        "memory",
        "receipt",
        "photo"
      ]
    },
    "common_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "common_role": {
      "type": "string",
      "enum": [
        "conductor",
        "scribe",
        "listener",
        "barkeeper",
        "scout",
        "appraiser",
        "cartographer",
        "judge",
        "architect",
        "quartermaster",
        "prospector",
        "planner",
        "builder",
        "validator",
        "breaker",
        "shipper",
        "keeper",
        "human"
      ]
    },
    "common_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "common_money": {
      "type": "object",
      "required": [
        "amount",
        "currency",
        "confidence_class"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "confidence_class": {
          "$ref": "#/$defs/common_confidence_class"
        },
        "basis": {
          "type": "string",
          "description": "how the number was derived"
        },
        "source": {
          "type": "string"
        },
        "priced_at": {
          "$ref": "#/$defs/common_date"
        }
      },
      "additionalProperties": false
    },
    "common_confidence_class": {
      "type": "string",
      "enum": [
        "rom",
        "budgetary",
        "definitive"
      ],
      "description": "rom +-50%, budgetary +-25%, definitive +-10%"
    },
    "common_date": {
      "type": "string",
      "format": "date"
    },
    "common_signoff": {
      "type": "object",
      "required": [
        "by",
        "role",
        "at",
        "decision"
      ],
      "properties": {
        "by": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/common_role"
        },
        "at": {
          "$ref": "#/$defs/common_timestamp"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "reject",
            "approve_with_conditions"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "common_provenance": {
      "type": "object",
      "required": [
        "produced_by",
        "produced_at"
      ],
      "properties": {
        "produced_by": {
          "$ref": "#/$defs/common_role"
        },
        "produced_at": {
          "$ref": "#/$defs/common_timestamp"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common_ref"
          }
        },
        "runtime": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "common_ref": {
      "type": "object",
      "required": [
        "artifact",
        "path"
      ],
      "properties": {
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "description": "sha256 of the file at hand-off"
        },
        "fragment": {
          "type": "string",
          "description": "optional JSON pointer or field"
        }
      },
      "additionalProperties": false
    }
  }
}
